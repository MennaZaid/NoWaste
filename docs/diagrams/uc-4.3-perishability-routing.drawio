style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1130" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="uc19" value="Choose destination for surplus (US-18, US-19)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="280" height="60" as="geometry"/></mxCell><mxCell id="ucunfit" value="Mark food unfit for people (US-19)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="250" height="60" as="geometry"/></mxCell><mxCell id="uc23v" value="Opt in to automatic charity offers (US-23)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="360" y="230" width="280" height="60" as="geometry"/></mxCell><mxCell id="uc25" value="Record landfill disposal (US-25)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="260" height="60" as="geometry"/></mxCell><mxCell id="uc46" value="Manage perishability rules (US-46, see 4.1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="270" height="60" as="geometry"/></mxCell><mxCell id="uc20" value="View nearby listings, most urgent first (US-20, US-21)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="300" height="60" as="geometry"/></mxCell><mxCell id="uc22" value="Accept donation and schedule pickup (US-22)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F8F4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="280" height="60" as="geometry"/></mxCell><mxCell id="uc24" value="Accept compost offer and schedule pickup (US-24)" style="ellipse