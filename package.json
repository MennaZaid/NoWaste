{
  "name": "nowaste",
  "version": "0.1.0",
  "private": true,
  "description": "NoWaste: location-based app that reduces food waste in Egypt (course project).",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w server",
    "migrate:test": "npm run migrate:test -w server",
    "seed:admin": "npm run seed:admin -w server --",
    "dev:server": "npm run dev -w server",
    "dev:worker": "npm run dev:worker -w server",
    "dev:app": "npm run start -w app",
    "build": "npm run build -w server",
    "test": "npm test -w server && npm test -w app",
    "lint": "npm run lint -w server && npm run lint -w app",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w app",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
