nt="1"><mxGeometry x="582" y="687" width="16" height="16" as="geometry"/></mxCell><mxCell id="irepo" value="IRepository" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#333333;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="782" y="687" width="16" height="16" as="geometry"/></mxCell><mxCell id="sdk" value="Map SDK" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#333333;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="117" y="922" width="16" height="16" as="geometry"/></mxCell><mxCell id="xapi" value="External APIs" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#333333;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="582" y="922" width="16" height="16" as="geometry"/></mxCell><mxCell id="sql" value="SQL" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#333333;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="807" y="922" width="16" height="16" as="geometry"/></mxCell><mxCell id="n" value="Entry points: C-02 serves requests from the app; C-19 runs time-based jobs. Both call the same application services. External systems are reached only through adapters (C-24 for the map).&#xa;Map data: C-01 sends the consumer location and the chosen distance to GET /listings/nearby (IApi); C-07 finds the offers within that distance with PostGIS (C-27, C-28) and the API returns each offer with its branch's pickup point; C-01 passes the points to C-24 (IMaps), which draws one pin per branch. The map service only supplies tiles; it never stores or searches listings." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="1140" width="700" height="100" as="geometry"/></mxCell><mxCell id="e0" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c01" target="iapi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c19" target="isvc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c02" target="isvc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c01" target="imaps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="svc" target="iad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="svc" target="irepo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c24" target="sdk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="ad" target="xapi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="html=1;rounded=0;endArrow=halfCircle;endFill=0;endSize=11;strokeColor=#333333;" edge="1" parent="1" source="c27" target="sql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" s