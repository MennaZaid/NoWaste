# Copy this file to server/.env and change the values if needed. Never commit server/.env.

# Port the REST API listens on.
PORT=3000

# Development database (docker compose service "db"). Use port 5433 here if you set DB_HOST_PORT=5433.
DATABASE_URL=postgres://nowaste:nowaste@localhost:5432/nowaste

# Database used only by the automated tests (npm test, npm run migrate:test).
TEST_DATABASE_URL=postgres://nowaste:nowaste@localhost:5432/nowaste_test

# Key that signs login tokens (JWT). Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. The automated tests make their own key when this is empty.
JWT_SECRET=
