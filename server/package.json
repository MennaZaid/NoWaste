{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "NoWaste backend: REST API (SDD C-02) and worker (SDD C-19) from one codebase.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "node --env-file-if-exists=.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d DATABASE_URL",
    "migrate:test": "node --env-file-if-exists=.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d TEST_DATABASE_URL",
    "migrate:create": "node ../node_modules/node-pg-migrate/bin/node-pg-migrate.js create -m migrations -j sql",
    "seed:admin": "tsx --env-file-if-exists=.env src/seedAdmin.ts",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nowaste/shared": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
